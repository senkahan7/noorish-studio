{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/components/Hero/**/*.ts",
    "src/components/Hero/**/*.tsx",
    "src/components/SelectedWork/**/*.ts",
    "src/components/SelectedWork/**/*.tsx",
    "src/js/heroMount.js",
    "src/js/selectedWorkMount.js"
  ]
}
